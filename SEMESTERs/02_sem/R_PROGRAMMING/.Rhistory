df2
students <- data.frame(
id = c(1,2,3,4),
name = c("A","B","C","D"),
dept = c("CS","IT","CS","IT")
)
marks <- data.frame(
id = c(1,2,3,4),
subject = c("ML","DBMS","ML","DBMS"),
score = c(85,90,78,88)
)
students
#select names and deprtment of students
select(df, name,dept)
#select names and deprtment of students
select(students, name,dept)
select(students,-id)
mean <- marks %>%group_by(subject)
mean
marks <- data.frame(
id = c(1,2,3,4),
subject = c("ML","DBMS","ML","DBMS"),
score = c(85,90,78,88)
)
marks
mean <- marks %>%group_by(subject) %>%summarise(average_score =mean(score))
mean
